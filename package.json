{
"name": "skinwise-vn",
"version": "0.1.0",
"private": true,
"scripts": {
"dev": "node --require ./scripts/configure-node-dns.cjs ./node_modules/next/dist/bin/next dev",
"build": "next build",
"start": "next start",
"lint": "eslint .",
"typecheck": "tsc --noEmit",
"test": "vitest run",
"test:watch": "vitest",
"test:ui": "vitest --ui",
"test:e2e": "playwright test",
"db:indexes": "node --env-file=.env.local --conditions=react-server --import tsx src/infrastructure/database/ensure-indexes.ts",
"db:seed": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed.ts",
"db:seed:e2e": "node --conditions=react-server --import tsx scripts/seed-e2e.ts"
},
"dependencies": {
"@auth/mongodb-adapter": "^3.11.2",
"class-variance-authority": "^0.7.1",
"clsx": "^2.1.1",
"lucide-react": "^1.14.0",
"mongodb": "^6.21.0",
"next": "16.2.6",
"next-auth": "^5.0.0-beta.31",
"radix-ui": "^1.4.3",
"react": "19.2.4",
"react-dom": "19.2.4",
"server-only": "^0.0.1",
"shadcn": "^4.7.0",
"tailwind-merge": "^3.6.0",
"tw-animate-css": "^1.4.0",
"zod": "^4.4.3"
},
"devDependencies": {
"@playwright/test": "^1.60.0",
"@tailwindcss/postcss": "^4",
"@types/node": "^20",
"@types/react": "^19",
"@types/react-dom": "^19",
"@vitest/ui": "^4.1.6",
"eslint": "^9",
"eslint-config-next": "16.2.6",
"tailwindcss": "^4",
"tsx": "^4.21.0",
"typescript": "^5",
"vitest": "^4.1.6"
},
"overrides": {
"postcss": "8.5.15",
"qs": "6.15.2",
"hono": "4.12.27"
},
"engines": {
"node": "24.x",
"npm": "11.x"
}
}
