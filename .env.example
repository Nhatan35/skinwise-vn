# SkinWise VN environment variables
# Copy this file to .env.local for local development.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Database
MONGODB_URI=

# Auth.js / NextAuth v5-style variables
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI provider - server-side only
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional / future private image upload
# Do not implement image upload in Week 1 unless the SDD scope is changed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Feature flags
FEATURE_AI_ROUTINE_ANALYSIS=false
FEATURE_INGREDIENT_EXPLANATION=false
FEATURE_IMAGE_UPLOAD=false
FEATURE_NOTIFICATIONS=false
FEATURE_MARKETPLACE=false
FEATURE_SKIN_SCORE=false
