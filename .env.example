# SkinWise VN environment variables.
# Copy this file to .env.local for local development.
# Use placeholders only here. Put real values in .env.local or the deployment dashboard.

# App
APP_ENV="development"
APP_BASE_URL="http://localhost:3000"

# Database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority"

# Auth.js / NextAuth v5-style variables
AUTH_SECRET="<generate-a-secure-random-secret>"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="<google-oauth-client-id>"
AUTH_GOOGLE_SECRET="<google-oauth-client-secret>"

# AI provider - server-side only.
# The current usable local/demo provider is "mock".
# OpenAI and Gemini providers are not implemented until a later task.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

# Playwright-only test authentication.
# E2E_TEST_AUTH must only be true when APP_ENV="test".
E2E_TEST_AUTH="false"
E2E_TEST_USER_EMAIL="e2e-user@skinwise.test"
E2E_TEST_USER_NAME="SkinWise E2E User"

# Optional / future private image upload.
# Image upload is out of scope for the current MVP.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Feature flags
FEATURE_AI_ROUTINE_ANALYSIS="false"
FEATURE_INGREDIENT_EXPLANATION="false"
FEATURE_IMAGE_UPLOAD="false"
FEATURE_NOTIFICATIONS="false"
FEATURE_MARKETPLACE="false"
FEATURE_SKIN_SCORE="false"
